<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up. The wallet keys live in filesDir and the preferences hold a
     RECOVERABLE encoding of the wallet PIN (CrazyPassEncoder is reversible), so any
     backup of this app is a copy of spendable funds wherever the backup lands. The
     app's own encrypted backup flow is the supported way to save a wallet. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
